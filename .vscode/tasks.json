{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run ControllerSketch (MinGW Qt)",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/c",
        "start",
        "build/ControllerSketch.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:/Qt/6.9.0/mingw_64/bin;${env:PATH}",
          "QT_PLUGIN_PATH": "C:/Qt/6.9.0/mingw_64/plugins"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}